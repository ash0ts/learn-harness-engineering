{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge course durable operation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "sourceCommit",
    "protocolSha256",
    "identity",
    "phase",
    "cleanup",
    "telemetry",
    "publication",
    "sandboxIds",
    "reservationIds",
    "requests",
    "evidence",
    "events",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,100}$"
    },
    "kind": {
      "enum": [
        "qualification",
        "trial",
        "loop",
        "graph"
      ]
    },
    "phase": {
      "enum": [
        "prepared",
        "running",
        "grading",
        "finalizing",
        "completed",
        "recoverable",
        "blocked_unknown"
      ]
    },
    "cleanup": {
      "enum": [
        "pending",
        "verified",
        "unknown"
      ]
    },
    "telemetry": {
      "enum": [
        "pending",
        "complete",
        "missing"
      ]
    },
    "publication": {
      "enum": [
        "pending",
        "verified",
        "failed",
        "not_required"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "entity",
        "project"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "notebook": {
          "type": "string"
        }
      }
    },
    "sandboxIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reservationIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "payloadBytes"
        ],
        "properties": {
          "status": {
            "enum": [
              "reserved",
              "reported",
              "unknown"
            ]
          },
          "payloadBytes": {
            "type": "integer",
            "minimum": 0
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "event"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "protocolSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "childPid": {
      "type": "integer",
      "minimum": 1
    }
  }
}
