diff --git a/scripts/check-architecture.sh b/scripts/check-architecture.sh
new file mode 100644
--- /dev/null
+++ b/scripts/check-architecture.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -eu
+# Qualification fixture: reject privileged module imports in renderer source.
+test -d src/renderer
+if grep -REn "(from|require\()[[:space:]]*['\"](node:|fs|path|electron|child_process)" src/renderer; then
+  echo 'Privileged module import found in renderer' >&2
+  exit 1
+fi
