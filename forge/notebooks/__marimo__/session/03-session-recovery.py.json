            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"bounded-rerun\">Bounded rerun</h2>\n<span class=\"paragraph\">Paid work requires this explicit button. The coordinator needs Node, installed pinned dependencies, external credentials, a successful qualification, and the existing durable budget ledger. Hosted analysis works without that coordinator. Configure its mounted checkout to enable execution; this notebook never creates a fresh $50 ledger on opening. A failed or uncertain request stays recorded.</span></span><marimo-ui-element object-id='PKri-0' random-id='1a2fb14b-0fe3-0448-c8f5-6d04dc0f1c02'><marimo-text data-initial-value='&quot;&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eShared coordinator checkout (absolute path)&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-placeholder='&quot;&quot;' data-kind='&quot;text&quot;' data-full-width='true' data-disabled='false' data-debounce='true'></marimo-text></marimo-ui-element><div style='display: flex;flex: 1;flex-direction: row;justify-content: space-between;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><marimo-ui-element object-id='PKri-1' random-id='3504bfd0-b1b3-c58f-cc96-fa089e36b1a3'><marimo-text data-initial-value='&quot;wandb&quot;' data-label='&quot;&#92;u003cspan class=&#92;&quot;markdown prose dark:prose-invert contents&#92;&quot;&#92;u003e&#92;u003cspan class=&#92;&quot;paragraph&#92;&quot;&#92;u003eW&amp;amp;B team&#92;u003c/span&#92;u003e&#92;u003c/span&#92;u003e&quot;' data-placeholder='&quot;&quot;' data-kind='&quot;text&quot;' data-full-width='false' data-disabled='false' data-debounce='true'></marimo-text></marimo-ui-element><marimo-ui-element object-id='PKri-2' random-i